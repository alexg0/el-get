(:name transient
       :website "https://github.com/magit/transient#readme"
       :description "Transient commands used by magit."
       :type github
       :pkgname "magit/transient"
       :branch "main"
       :minimum-emacs-version "25.1"
       :info "docs"
       :load-path "lisp/"
       :compile "lisp/"
       ;; Build info directly: transient's Makefile uses `sed -i -e`
       ;; (GNU syntax) which fails on macOS/BSD sed.
       ;; See https://github.com/magit/transient/pull/428
       :build (("makeinfo" "--no-split" "docs/transient.texi" "-o" "docs/transient.info"))
       ;; Assume windows lacks a build environment.
       :build/windows-nt (with-temp-file "lisp/transient-autoloads.el" nil))
